# Copy this file to .env and fill in your key(s).

# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional — only needed for the "jarvis" wake word (WAKE_WORD_ENABLED in
# main.py). Free key from https://console.picovoice.ai
# If unset, JARVIS simply listens continuously.
PICOVOICE_ACCESS_KEY=your-picovoice-access-key-here
